#!name=去广告合集（多屏互动+小白打印）
#!desc=合并自两个插件：移除多屏互动、小白智慧打印的开屏广告、横幅推广、搜索填充词与广告下发。小白打印账户页面异常为原插件已知问题。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=iKeLee
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-11-21 09:02:43
#!requirement=CORE_VERSION>=6008000
# 合并来源：多屏互动去广告 / 小白智慧打印去广告（原作者：可莉）
# 原插件的 #!icon 与 #!openUrl 分别指向不同 App，合并后已移除。

[Rule]
DOMAIN,ad.lovefree.cc,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,adwanji.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/config\/function\?) '.data |= map(select(.module == "tools"))'
http-response-jq (?i:^https:\/\/epbox\.gongfudou\.com\/graphql$) 'delpaths([["data","mallConsumables"]])'
http-response-jq (?i:^https:\/\/epbox\.gongfudou\.com\/graphql$) 'delpaths([["data","currentUser","goodsCoupons"]])'
http-response-jq (?i:^https:\/\/epbox\.gongfudou\.com\/graphql$) 'if .data.systemConfig.searchHotTags? then del(.data.systemConfig) else . end'
http-response-jq (?i:^https:\/\/epbox\.gongfudou\.com\/graphql$) 'if (.data.page.__typename=="Page" and .data.page.name=="场景化改版 2024") then .data.page.firstTabDetail.floors|=map(select(.numType=="row")) else . end'

[Map Local]
(?i:^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/ads\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\/banner$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/searchrank$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/message\/v\d\/activity\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/banners\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/canvas\/query_actions\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% tcast-o.api.leiniao.com, epbox.gongfudou.com
